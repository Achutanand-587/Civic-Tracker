# Firebase Configuration
VITE_FCM_VAPID_KEY=your_fcm_vapid_key_here

# Backend
FIREBASE_SERVICE_ACCOUNT_JSON=./pmc-service-account.json
PORT=5000

# Database Scheduler
CRON_ENABLED=true
CRON_SCHEDULE=*/15 * * * *

# Feature Toggles
FEATURE_GEOFENCE=true
FEATURE_SLA_ESCALATION=true
FEATURE_PUSH_NOTIFICATIONS=true

# Geofence Configuration
GEOFENCE_RADIUS_METERS=100
GPS_ACCURACY_THRESHOLD=50

# SLA Configuration
SLA_HOURS_LOW=168
SLA_HOURS_MEDIUM=72
SLA_HOURS_HIGH=24
SLA_HOURS_CRITICAL=4

# Escalation Deadlines
ESCALATION_LEVEL_1_HOURS=12
ESCALATION_LEVEL_2_HOURS=4
